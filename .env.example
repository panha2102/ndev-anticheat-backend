# Server Configuration
PORT=3005
HOST=0.0.0.0

# Admin Dashboard Credentials (initial seed; can be changed inside Dashboard -> Settings)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
JWT_SECRET=ndev-anticheat-super-secret-change-me-2026

# Client Authentication Secrets (must match code/components/ndev-core-five)
# Component.cpp -> AC_HIDE_STR(0xA7, "NDEV@LAUNCHER@2026")
SCANNER_PIN=NDEV@LAUNCHER@2026

# NdevAnticheat.cpp -> X-Anticheat-Secret header
ANTICHEAT_LOG_SECRET=replace-with-private-secret

# Optional initial Discord Webhooks (can also be configured live in Dashboard -> Settings)
DISCORD_WEBHOOK_BAN=
DISCORD_WEBHOOK_WARNING=
DISCORD_WEBHOOK_TRACKING=
DISCORD_WEBHOOK_LOGS=

# Storage paths
DATA_DIR=./storage
